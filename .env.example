# Optional: Code Work Connect source builds
# `cp .env.example .env` enables Code Work Connect against the production deployment.
# These are public identifiers baked into official release builds, not secrets.
# Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.
#
# CODEWORK_* is canonical. Existing CODEWORK_* variables remain supported as a
# fallback for upgrades and CI; when both are present, CODEWORK_* wins.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
CODEWORK_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
CODEWORK_CLERK_JWT_TEMPLATE=t3-relay
CODEWORK_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CODEWORK_CLERK_PUBLISHABLE_KEY. Set the override only when
# Clerk returns a different RP ID or when multiple domains must be entitled.
# CODEWORK_APPLE_TEAM_ID=ABC1234567
# CODEWORK_MACOS_PROVISIONING_PROFILE=/absolute/path/to/code-work.provisionprofile
# CODEWORK_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
CODEWORK_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# CODEWORK_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# CODEWORK_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# CODEWORK_MOBILE_OTLP_TRACES_DATASET=code-work-mobile-traces-dev
# CODEWORK_MOBILE_OTLP_TRACES_TOKEN=xaat-...
