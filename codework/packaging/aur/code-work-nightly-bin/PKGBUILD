# Maintainer: maria-rcks <maria at kuuro dot net>

pkgname=code-work-nightly-bin
pkgver=0.0.34_nightly.20260814.1095
pkgrel=1
pkgdesc='Nightly desktop control surface for local coding agents'
arch=('x86_64')
url='https://github.com/Sakana-yuyu/code-work'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
optdepends=('openai-codex: use the system-installed Codex CLI')
provides=("code-work-nightly=$pkgver" "codework-nightly=$pkgver")
conflicts=('codework-nightly-bin' 'codework-nightly' 'codework')
replaces=('codework-nightly-bin')
options=('!debug' '!strip')

_upstream_version="${pkgver/_nightly./-nightly.}"
_appimage="Code-Work-${_upstream_version}-x86_64.AppImage"
source=(
  "$_appimage::https://github.com/Sakana-yuyu/code-work/releases/download/v${_upstream_version}/$_appimage"
  "${pkgname}-${pkgver}-LICENSE::https://raw.githubusercontent.com/Sakana-yuyu/code-work/v${_upstream_version}/LICENSE"
)
sha256sums=(
  'c4dea5bba9ed0b51b2f60f2d4a4867e61d62b57c50ea66f2792a73112e054566' # AppImage
  '935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43' # upstream license
)

prepare() {
  chmod +x "$srcdir/$_appimage"
  rm -rf "$srcdir/squashfs-root"
  "$srcdir/$_appimage" --appimage-extract >/dev/null

  if [[ ! -x "$srcdir/squashfs-root/AppRun" ||
        ! -f "$srcdir/squashfs-root/chrome-sandbox" ]]; then
    echo 'The AppImage payload is missing its launcher or Chromium sandbox.' >&2
    return 1
  fi
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/squashfs-root/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/code-work-nightly" <<'EOF'
#!/bin/sh
exec /opt/code-work-nightly-bin/AppRun "$@"
EOF
  ln -s code-work-nightly "$pkgdir/usr/bin/codework-nightly"
  ln -s code-work-nightly "$pkgdir/usr/bin/code-work-nightly-desktop"

  # Icon lookup only sees sizes registered in hicolor's index.theme (max 512x512).
  local icon size_dir icon_name
  for icon_name in code-work-nightly.png code-work.png codework.png; do
    for icon in "$srcdir"/squashfs-root/usr/share/icons/hicolor/*/apps/$icon_name; do
      [[ -f "$icon" ]] || continue
      size_dir="${icon%/apps/$icon_name}"
      install -Dm644 "$icon" \
        "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/code-work-nightly.png"
    done
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/code-work-nightly.desktop" <<'EOF'
[Desktop Entry]
Name=Code Work (Nightly)
Comment=Nightly desktop control surface for local coding agents
Exec=code-work-nightly %U
TryExec=code-work-nightly
Terminal=false
Type=Application
Icon=code-work-nightly
StartupWMClass=code-work
Categories=Development;
MimeType=x-scheme-handler/codework;x-scheme-handler/codework-dev;x-scheme-handler/codework-preview;x-scheme-handler/codework;x-scheme-handler/codework-dev;x-scheme-handler/codework-preview;
EOF

  install -Dm644 "$srcdir/${pkgname}-${pkgver}-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
